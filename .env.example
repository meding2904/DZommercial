# In production these must be set explicitly. The development admin password is
# rejected, and SEED_DEMO defaults to false.
# Go API
APP_ENV=development
API_ADDR=:8080
APP_ORIGIN=http://localhost:5173
TURSO_DATABASE_URL=http://127.0.0.1:8880
TURSO_AUTH_TOKEN=
COOKIE_SECURE=false
TRUST_PROXY=false
SEED_DEMO=true
ADMIN_EMAIL=admin@azahar.example
ADMIN_PASSWORD=azahar-dev-admin-2026
CUSTOMER_EMAIL=client@azahar.example
CUSTOMER_PASSWORD=azahar-dev-client-2026

# Courier integration. The sandbox courier needs no account and creates no
# parcels; it validates the same fields as a real courier. Set a real courier
# key and its JSON credentials for live shipments.
COURIER_API_URL=https://freeship.dzbuild.com
COURIER_KEY=sandbox
COURIER_CREDENTIALS=
COURIER_FROM_WILAYA=16
COURIER_TIMEOUT_SECONDS=12

# Cloudflare Turnstile. Leave empty in development to use the local captcha.
# Production requires both keys.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Hidden admin gate token. Kiri generates a random one at startup and prints the gate URL.
# Without a token the development fallback is "devtoken", gate http://localhost:5173/ops-devtoken.
ADMIN_ACCESS_TOKEN=

# SvelteKit server
INTERNAL_API_URL=http://127.0.0.1:8080
PUBLIC_SITE_URL=http://localhost:5173
