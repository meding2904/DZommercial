FROM node:22-alpine AS build

RUN corepack enable
WORKDIR /app

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ ./
RUN pnpm build

FROM node:22-alpine AS runtime

RUN addgroup -S azahar && adduser -S azahar -G azahar
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --from=build --chown=azahar:azahar /app/build ./build

USER azahar
EXPOSE 3000

CMD ["node", "build"]
